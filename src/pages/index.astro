---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import FormEmbed from "../components/FormEmbed.astro";
import CTAButton from "../components/CTAButton.astro";
import { config, telLink, getClientImage } from "../lib/config";
import { blogPosts as latestBlogPosts, getCategory } from "../data/blog";

const city = config.practice.city;
const state = config.practice.state;
const displayCity = city || "Hickory";
const displayState = state || "NC";
const heroImage = getClientImage("homepage_hero") || { file_path: "/images/podiatrist-foot-exam-clinic.jpg", alt_text: "" };
const doctorImage = getClientImage("doctor_profile") || { file_path: "/images/doctor-patient-consultation.png", alt_text: "Podiatrist gently examining a patient's foot during a consultation" };
const clinicImage = getClientImage("clinic_gallery", "clinic_interior") || { file_path: "/images/treatment-room-interior.jpg", alt_text: "Clean podiatry treatment room" };
const exteriorImage = getClientImage("contact_page", "clinic_exterior") || getClientImage("clinic_gallery", "clinic_exterior") || { file_path: "/images/podiatrist-loupe-exam.jpg", alt_text: "Podiatrist examining a foot in a clinical setting" };
const sportsImage = getClientImage("sports_medicine_section", "patient_lifestyle") || { file_path: "/client-images/dr-johncock-race-community.webp", alt_text: "Runner pushing a racing chair during a road race" };
const doctorName = config.doctor?.name ? `Dr. ${config.doctor.name}` : config.practice.name;
const doctorCredentials = config.doctor?.credentials || "";
const doctorTitle = config.doctor?.title || "Podiatrist";
const doctorSpecialties = "Heel pain, sports foot care, diabetic foot care, nail care";
const appointmentLabel = config.appointments?.booking_cta_label || "Request Appointment";

const valueProps = [
  { icon: "/icons/heel-glow.svg", title: "Heel and Arch Pain", body: "Heel pain with first steps, standing, or exercise can happen with plantar fasciitis, heel spurs, tendon irritation, or overuse. A podiatrist can examine the foot and explain treatment options." },
  { icon: "/icons/running.svg", title: "Care for Active Feet", body: "Runners, walkers, workers who stand most of the day, and people returning to exercise often need help when foot or ankle pain keeps coming back." },
  { icon: "/icons/nail.svg", title: "Nail and Skin Problems", body: "Ingrown toenails, thick nails, corns, calluses, plantar warts, and shoe pressure around the toes can make normal walking painful." },
  { icon: "/icons/diabetic-foot.svg", title: "Diabetic Foot Concerns", body: "Diabetic foot checks, wounds, ulcers, circulation concerns, and pressure areas deserve careful attention from a foot and ankle doctor." },
  { icon: "/icons/balance.svg", title: "Conservative Steps First", body: "Many visits start with footwear advice, stretching, padding, bracing, activity changes, or supportive inserts before advanced care is discussed." },
  { icon: "/icons/scalpel.svg", title: "Surgical Foot Care", body: "When conservative care is not enough, Dr. Johncock can discuss whether surgical consultation fits the diagnosis, goals, and risks." },
];

const conditions = [
  { icon: "/icons/heel-glow.svg", name: "Plantar Fasciitis", href: "/conditions/plantar-fasciitis", note: "Heel and arch pain with first steps" },
  { icon: "/icons/bunion.svg", name: "Bunions", href: "/conditions/bunions", note: "Big toe pressure and shoe irritation" },
  { icon: "/icons/heel-highlighted.svg", name: "Heel Pain & Spurs", href: "/conditions/heel-pain", note: "Heel soreness with standing or walking" },
  { icon: "/icons/feet.svg", name: "Hammertoes", href: "/conditions/hammertoes", note: "Bent toes, corns, and shoe rubbing" },
  { icon: "/icons/nail.svg", name: "Ingrown Toenails", href: "/conditions/ingrown-toenails", note: "Painful nail edges, redness, or swelling" },
  { icon: "/icons/diabetic-foot.svg", name: "Diabetic Foot Care", href: "/conditions/diabetic-foot-care", note: "Foot checks, wounds, and pressure spots" },
  { icon: "/icons/running.svg", name: "Sports Injuries", href: "/conditions/sports-injuries", note: "Running pain, sprains, and tendon strain" },
  { icon: "/icons/sprained.svg", name: "Sprained Ankles", href: "/conditions/ankle-pain/", note: "Swelling, instability, or repeat pain" },
];

const treatments = [
  { icon: "/icons/heel-glow.svg", name: "Heel Pain Treatment", href: "/conditions/heel-pain", body: "A foot doctor evaluates heel and arch pain, then explains care options based on the exam and what has already been tried.", price: "Heel and arch pain", featured: true },
  { icon: "/icons/insole.svg", name: "Custom Orthotics", href: "/treatments/orthotics", body: "Custom orthotics may help when pressure, arch support, foot alignment, or overuse contributes to pain.", price: "Arch support" },
  { icon: "/icons/running.svg", name: "Sports Foot Care", href: "/conditions/sports-injuries", body: "Sports foot care can help with running pain, tendon irritation, sprains, and recurring pain during activity.", price: "Active feet" },
  { icon: "/icons/nail.svg", name: "Ingrown Toenail and Nail Care", href: "/conditions/ingrown-toenails", body: "A podiatrist can evaluate painful nail edges, thick nails, nail infection concerns, and shoe pressure around the toes.", price: "Nail pain" },
  { icon: "/icons/band-aid.svg", name: "Diabetic and Wound Care", href: "/conditions/diabetic-foot-care", body: "Diabetic foot visits may include foot checks, pressure-area review, wound care questions, and prevention guidance.", price: "High-risk feet" },
  { icon: "/icons/scalpel.svg", name: "Foot Surgery Consultation", href: "/treatments/surgery", body: "Surgical consultation may be appropriate when conservative care does not solve a foot or ankle problem.", price: "When needed" },
];

const resources = [
  { icon: "/icons/clipboard.svg", title: "New Patient Guide", body: "What to bring, how to prepare, and which questions to ask before your first podiatry visit.", href: "/new-patients", color: "primary", action: "Prepare for your first visit" },
  { icon: "/icons/bar-chart.svg", title: "Compare Care Options", body: "Plain-language guidance on conservative care, orthotics, procedures, and surgery conversations.", href: "/compare", color: "secondary", action: "Compare treatment paths" },
  { icon: "/icons/medical-card.svg", title: "Insurance & Payment", body: "Call the clinic to verify coverage for your specific plan before booking.", href: "/insurance", color: "secondary", action: "Review payment questions" },
  { icon: "/icons/book.svg", title: "Resources Hub", body: "Practical guides for appointment prep, home care, procedures, and follow-up questions.", href: "/patient-resources", color: "accent", action: "Browse patient resources" },
  { icon: "/icons/question.svg", title: "FAQ", body: "Short answers about conditions, appointments, insurance questions, and first visits.", href: "/faq", color: "slate", action: "Read common questions" },
  { icon: "/icons/google-docs.svg", title: "Blog Articles", body: "Patient-friendly articles about common foot pain questions and treatment decisions.", href: "/blog", color: "primary", action: "Browse foot care articles" },
];

const blogPosts = latestBlogPosts.slice(0, 3);

const stats = [
  { number: "Hickory, NC", label: "Foot and ankle clinic" },
  { number: "(828) 327-3029", label: "Call the office" },
  { number: "36 14th Ave NE", label: "Suite 102" },
  { number: "Coverage", label: "Verify by phone" },
];

const homeFaqs = [
  { question: "Do I need a referral to see a foot doctor?", answer: "Some insurance plans require a referral, and others do not. Call the office or your insurance plan before booking so you know what your plan requires." },
  { question: "What does a podiatrist treat?", answer: "A podiatrist treats foot and ankle problems such as heel pain, plantar fasciitis, bunions, hammertoes, ingrown toenails, fungal nail concerns, sports injuries, wounds, and diabetic foot concerns." },
  { question: "When should I see a foot doctor for heel pain?", answer: "Consider calling a foot doctor when heel pain lasts more than a few days, keeps returning, is worse in the morning, or changes how you walk. A podiatrist can examine the foot and explain likely next steps." },
  { question: "Does insurance cover podiatry visits?", answer: "Coverage depends on your plan, diagnosis, and visit type. Call Carolina Podiatry Center before booking to verify coverage for your specific insurance plan." },
  { question: "What happens at the first visit?", answer: "The doctor reviews your symptoms, medical history, shoes, activity level, and any treatments you have already tried. The visit may include a foot or ankle exam and a discussion of conservative care, imaging, procedures, or follow-up when appropriate." },
  { question: "Where is Carolina Podiatry Center located?", answer: "Carolina Podiatry Center is located at 36 14th Avenue NE, Suite 102, Hickory, NC 28601. Call the office if you need directions or current appointment availability." },
];
---

<BaseLayout
  title={`${displayCity}, ${displayState} Podiatrist | ${doctorName}, ${doctorCredentials}`}
  description={`Need a foot doctor in Hickory, NC? Carolina Podiatry Center provides podiatry care for heel pain, sports injuries, nail problems, diabetic foot concerns, wounds, and foot surgery questions.`}
  canonicalPath="/"
>
  {/* ───────── 1. HERO ───────── */}
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <img src={heroImage.file_path} alt="" />
      <div class="hero__overlay"></div>
    </div>
    <div class="container hero__inner">
      <div class="hero__content">
        <div class="hero__badge">
          <span class="hero__badge-dot"></span>
          {config.practice.tagline}
        </div>
        <h1>
          {displayCity}, {displayState} Podiatrist - <span class="hero__hl">{doctorName}, {doctorCredentials}</span>
        </h1>
        <p class="hero__sub">
          Foot and ankle care at Carolina Podiatry Center for heel pain, plantar fasciitis, bunions, ingrown toenails, diabetic foot concerns, sports injuries, wounds, and other common podiatry problems.
        </p>
        <div class="hero__ctas">
          <CTAButton href={telLink()} variant="accent" size="large">
            <span class="cta__icon"><img src="/icons/telephone.svg" alt="" width="18" height="18" /></span>
            {config.contact.phone}
          </CTAButton>
          <CTAButton href="#book" variant="outline" size="large">
            <span class="cta__icon"><img src="/icons/mail.svg" alt="" width="18" height="18" /></span>
            {appointmentLabel}
          </CTAButton>
        </div>
        <div class="hero__signals">
          <div class="hero__signal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E8A33D" stroke-width="2.2" aria-hidden="true">
              <path d="M12 21s7-6.2 7-12A7 7 0 105 9c0 5.8 7 12 7 12z"/>
              <circle cx="12" cy="9" r="2.5"/>
            </svg>
            <span><strong>36 14th Ave NE</strong> Suite 102</span>
          </div>
          <div class="hero__signal-divider"></div>
          <div class="hero__signal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E8A33D" stroke-width="2.2" aria-hidden="true">
              <path d="M12 2 L4 6 V12 C4 17 7.5 21 12 22 C16.5 21 20 17 20 12 V6 Z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
            <span>{doctorName}{doctorCredentials && `, ${doctorCredentials}`}</span>
          </div>
          <div class="hero__signal-divider"></div>
          <div class="hero__signal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E8A33D" stroke-width="2.2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>Call to verify coverage and availability</span>
          </div>
        </div>
      </div>
    </div>
    <svg class="hero__swoosh" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,120 C240,60 480,20 720,40 C960,60 1200,100 1440,80 L1440,120 Z" fill="#FFFFFF" opacity="0.95"/>
      <path d="M0,120 C240,80 480,40 720,60 C960,80 1200,110 1440,100 L1440,120 Z" fill="#FFFFFF"/>
    </svg>
  </section>

  {/* ───────── 2. TRUST STRIP ───────── */}
  <section class="trust-strip">
    <div class="container trust-strip__inner">
      {stats.map((s) => (
        <div class="trust-strip__item">
          <strong>{s.number}</strong>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  {/* ───────── 3. OUR APPROACH ───────── */}
  <section class="section section--approach">
    <div class="container approach">
      <div class="approach__media">
        <div class="approach__image-frame">
          <img src={doctorImage.file_path} alt={doctorImage.alt_text} loading="lazy" />
        </div>
        <div class="approach__badge">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 2 L4 6 V12 C4 17 7.5 21 12 22 C16.5 21 20 17 20 12 V6 Z"/>
            <polyline points="9 12 11 14 15 10"/>
          </svg>
          <div>
            <strong>{doctorName}{doctorCredentials && `, ${doctorCredentials}`}</strong>
            <span>{doctorTitle}</span>
            <small>{doctorSpecialties}</small>
          </div>
        </div>
      </div>
      <div class="approach__copy">
        <p class="section-head__eyebrow">Our Approach</p>
        <h2>Start With the Cause of the Foot Pain</h2>
        <p>
          Foot pain often builds from more than one thing: shoes, standing work, training habits, walking mechanics, diabetes, circulation, old injuries, or pressure that keeps returning to the same spot. A podiatry visit starts by sorting out what is likely driving the problem.
        </p>
        <p>
          Dr. Johncock's care can include conservative steps such as footwear guidance, stretching, padding, bracing, orthotics, activity changes, and follow-up. If symptoms continue or the exam points to a more serious problem, the visit can include a discussion of imaging, procedures, wound care, or surgical consultation.
        </p>
        <p>
          The goal is to explain the foot or ankle problem in plain language and help patients understand the next step before they leave the office.
        </p>
        <CTAButton href="/doctor" variant="primary">Meet Dr. Johncock</CTAButton>
      </div>
    </div>
  </section>

  {/* ───────── 3. WHY CHOOSE US ───────── */}
  <section class="section section--why">
    <div class="container">
      <div class="section-head">
        <p class="section-head__eyebrow">Local Foot Care</p>
        <h2>A Hickory Foot Doctor for Everyday Pain, Sports Injuries, and Diabetic Feet</h2>
        <p class="section-head__sub">
          Most patients do not start by searching for a treatment. They start because the heel hurts, a toenail is painful, an ankle keeps swelling, or diabetes makes foot care more important.
        </p>
      </div>
      <div class="props-grid">
        {valueProps.map((p, i) => (
          <div class={`prop-card prop-card--${i % 3}`}>
            <div class="prop-card__iconwrap">
              <img src={p.icon} alt="" width="32" height="32" />
            </div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ───────── 5. CLINIC GLIMPSE ───────── */}
  <section class="section section--clinic-glimpse">
    <div class="container clinic-glimpse">
      <div class="clinic-glimpse__copy">
        <p class="section-head__eyebrow">Inside the Hickory Office</p>
        <h2>Local Podiatry Care in Hickory</h2>
        <p>Carolina Podiatry Center gives patients a local place to ask about heel pain, sports injuries, painful toenails, diabetic foot concerns, wounds, and follow-up foot care. Call the office if you need directions to the Hickory location or want to ask about appointment options.</p>
      </div>
      <div class="clinic-glimpse__images">
        <img src={clinicImage.file_path} alt={clinicImage.alt_text} loading="lazy" />
        <img src={exteriorImage.file_path} alt={exteriorImage.alt_text} loading="lazy" />
      </div>
    </div>
  </section>

  {/* ───────── 6. CONDITIONS ───────── */}
  <section class="section section--conditions">
    <div class="conditions__pattern" aria-hidden="true"></div>
    <div class="container">
      <div class="section-head">
        <p class="section-head__eyebrow">Conditions We Treat</p>
        <h2>Common Foot and Ankle Problems Treated in Hickory</h2>
        <p class="section-head__sub">
          Start with the problem you feel: morning heel pain, toe pressure, painful nails, ankle swelling, wounds, or foot pain during work and exercise. A podiatrist can examine the foot and explain what may be causing it.
        </p>
      </div>
      <div class="tile-grid">
        {conditions.map((c) => (
          <a href={c.href} class="condition-tile">
            <div class="condition-tile__icon">
              <img src={c.icon} alt="" width="36" height="36" />
            </div>
            <h3>{c.name}</h3>
            <p>{c.note}</p>
            <span class="condition-tile__arrow" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </span>
          </a>
        ))}
      </div>
      <div class="section-cta">
        <CTAButton href="/conditions" variant="outline">See All Conditions We Treat</CTAButton>
      </div>
    </div>
  </section>

  {/* ───────── 7. TREATMENTS ───────── */}
  <section class="section section--treatments">
    <div class="container">
      <div class="section-head">
        <p class="section-head__eyebrow">Treatments We Offer</p>
        <h2>Treatment Options After a Foot and Ankle Exam</h2>
        <p class="section-head__sub">
          Treatment depends on the diagnosis, symptoms, activity level, medical history, and what has already been tried. The right plan may include home care, shoe changes, orthotics, wound care, a procedure, or a surgical consultation.
        </p>
      </div>
      <div class="treatments-grid">
        {treatments.map((t) => (
          <a href={t.href} class={`treatment-card ${t.featured ? "treatment-card--featured" : ""}`}>
            {t.featured && <span class="treatment-card__badge">Common Concern</span>}
            <div class="treatment-card__icon">
              <img src={t.icon} alt="" width="36" height="36" />
            </div>
            <h3>{t.name}</h3>
            <p>{t.body}</p>
            <div class="treatment-card__foot">
              <span class="treatment-card__price">{t.price}</span>
              <span class="treatment-card__link">View {t.name}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="section-cta">
        <CTAButton href="/treatments" variant="primary">Browse All Treatments</CTAButton>
      </div>
    </div>
  </section>

  {/* ───────── 8. MID-PAGE CTA ───────── */}
  <section class="mid-cta">
    <div class="mid-cta__shapes" aria-hidden="true">
      <div class="mid-cta__circle mid-cta__circle--1"></div>
      <div class="mid-cta__circle mid-cta__circle--2"></div>
    </div>
    <div class="container mid-cta__inner">
      <div class="mid-cta__copy">
        <p class="mid-cta__eyebrow">Need a Foot Doctor in Hickory?</p>
        <h2>Ask About Appointment Options</h2>
        <p>If heel pain, nail pain, ankle pain, or a diabetic foot concern is affecting your day, call the office and ask about current appointment availability.</p>
      </div>
      <div class="mid-cta__actions">
        <CTAButton href={telLink()} variant="accent" size="large">
          <span class="cta__icon"><img src="/icons/telephone.svg" alt="" width="18" height="18" /></span>
          {config.contact.phone}
        </CTAButton>
        <CTAButton href="#book" variant="outline" size="large">
          <span class="cta__icon"><img src="/icons/mail.svg" alt="" width="18" height="18" /></span>
          {appointmentLabel}
        </CTAButton>
      </div>
    </div>
  </section>

  {/* ───────── 9. PATIENT EXPERIENCE ───────── */}
  <section class="section section--experience">
    <div class="container experience">
      <div class="experience__copy">
        <p class="section-head__eyebrow">The Patient Experience</p>
        <h2>What Happens Before and During a Visit</h2>
        <p>
          The first step is practical. Call the office or use the form to describe what is bothering you, ask about appointment options, and verify insurance or payment details before booking.
        </p>
        <p>
          During a podiatry visit, Dr. Johncock reviews the problem, examines the foot or ankle, asks what has already been tried, and explains the likely next step. That may include conservative care, imaging, wound care, a procedure discussion, or follow-up when appropriate.
        </p>
        <ul class="experience__list">
          <li>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Bring the shoes you wear most often</span>
          </li>
          <li>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Bring insurance details and current medications</span>
          </li>
          <li>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Explain when pain started and what makes it worse</span>
          </li>
          <li>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Ask the office to verify coverage before booking</span>
          </li>
        </ul>
      </div>
      <div class="experience__media">
        <img src="/images/welcoming-clinic-entrance.png" alt="Welcoming entrance to our podiatry clinic" loading="lazy" class="experience__img experience__img--tall" />
        <img src="/images/foot-massage-warm-hands.jpg" alt="Hands gently cradling a patient's foot during examination" loading="lazy" class="experience__img experience__img--top" />
        <div class="experience__stat-card">
          <div class="experience__stat-number">1<span>plan</span></div>
          <p>A clear next step for your foot or ankle concern</p>
          <svg class="experience__stat-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
      </div>
    </div>
  </section>

  {/* ───────── 10. AREAS WE SERVICE ───────── */}
  <section class="section section--areas">
    <div class="container areas">
      <div class="areas__copy">
        <p class="section-head__eyebrow">Greater {displayCity} Service Area</p>
        <h2>Foot and Ankle Care for Hickory and Nearby Communities</h2>
        <p>
          Carolina Podiatry Center serves patients in Hickory and nearby Catawba Valley communities, including Newton, Conover, Lenoir, Morganton, and Taylorsville. Foot pain often shows up in active adults, workers who stand most of the day, older adults managing diabetes, and patients returning to walking or exercise.
        </p>
        <div class="area-chips">
          <span class="area-chip area-chip--primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C7.58 2 4 5.58 4 10c0 5.25 7 12 7.34 12.29.18.17.46.17.66.01.34-.27 7.34-7.04 7.34-12.3 0-4.42-3.58-8-8-8zm0 11a3 3 0 110-6 3 3 0 010 6z"/>
            </svg>
            {displayCity}
          </span>
          {config.nearby_areas.map((area) => (
            <span class="area-chip">{area}</span>
          ))}
        </div>
        <CTAButton href="/locations" variant="primary">See All Locations Served</CTAButton>
      </div>
      <div class="areas__media">
        <div class="areas__image-frame">
          <img src={sportsImage.file_path} alt={sportsImage.alt_text} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  {/* ───────── 11. PATIENT RESOURCES ───────── */}
  <section class="section section--resources">
    <div class="container">
      <div class="section-head">
        <p class="section-head__eyebrow">Patient Resources</p>
        <h2>Patient Resources Before and After a Foot Visit</h2>
      </div>
      <div class="resources-grid">
        {resources.map((r) => (
          <a href={r.href} class={`resource-card resource-card--${r.color}`}>
            <div class="resource-card__icon">
              <img src={r.icon} alt="" width="28" height="28" />
            </div>
            <h3>{r.title}</h3>
            <p>{r.body}</p>
            <span class="resource-card__more">{r.action}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ───────── 12. BLOG ───────── */}
  <section class="section section--blog">
    <div class="container">
      <div class="section-head">
        <p class="section-head__eyebrow">Foot Care Articles</p>
        <h2>Foot Care Articles for Hickory Patients</h2>
        <p class="section-head__sub">
          Read practical articles about heel pain, plantar fasciitis, sports injuries, nail problems, diabetic foot care, and when it makes sense to call a podiatrist.
        </p>
      </div>
      <div class="blog-grid">
        {blogPosts.map((post) => (
          <a href={post.href} class="blog-card">
            <div class="blog-card__image">
              <img src={post.image} alt={post.title} loading="lazy" />
