---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CTAButton from "../components/CTAButton.astro";
import { config, telLink } from "../lib/config";
---

<BaseLayout title={`Insurance and Payment | ${config.practice.name}`} description="Insurance and payment information patients should confirm before booking." canonicalPath="/insurance">
  <section class="page-hero">
    <div class="container--narrow">
      <p class="eyebrow">Insurance & Payment</p>
      <h1>Confirm Coverage Before Booking</h1>
      <p class="lede">Coverage varies by provider, plan, location, and visit type. The clinic team should confirm details before patients rely on insurance claims.</p>
      <div class="button-row">
        <CTAButton href={telLink()} variant="accent"><span class="cta__icon"><img src="/icons/telephone.svg" alt="" width="18" height="18" /></span>{config.contact.phone}</CTAButton>
        <CTAButton href="/#book" variant="outline">Request Consultation</CTAButton>
      </div>
    </div>
  </section>
  <Breadcrumbs items={[{ label: "Insurance" }]} />
  <section class="section section--tight">
    <div class="container--narrow copy">
      <h2>What This Page Should Do</h2>
      <p>This page should list insurance carriers only when they are confirmed in the config and supported by real client-provided details. In demo mode, it should steer patients to call and verify coverage.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: var(--brand-light-bg); padding: var(--space-8) 0; text-align: center; }
  .eyebrow { color: var(--brand-accent); font-family: var(--font-heading); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.08em; margin-bottom: var(--space-3); text-transform: uppercase; }
  .lede, .copy p { color: var(--brand-slate); }
  .button-row { display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center; margin-top: var(--space-5); }
</style>
