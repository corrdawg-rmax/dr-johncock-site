---
export type SummaryFact = {
  icon: string;
  label: string;
  value: string;
};

export type SummaryRow = {
  label: string;
  summary: string;
  action: string;
};

export interface Props {
  title: string;
  intro: string;
  facts?: SummaryFact[];
  rows?: SummaryRow[];
  bullets?: string[];
}

const { title, intro, facts = [], rows = [], bullets = [] } = Astro.props;
---

<aside class="blog-summary" aria-label="Article summary">
  <div class="blog-summary__head">
    <p>Quick Summary</p>
    <h2>{title}</h2>
    <span aria-hidden="true">🩺</span>
  </div>
  <p class="blog-summary__intro">{intro}</p>

  {facts.length > 0 && (
    <div class="blog-summary__facts">
      {facts.map((fact) => (
        <div class="blog-summary__fact">
          <img src={fact.icon} alt="" width="24" height="24" />
          <div>
            <span>{fact.label}</span>
            <strong>{fact.value}</strong>
          </div>
        </div>
      ))}
    </div>
  )}

  {rows.length > 0 && (
    <div class="blog-summary__table">
      {rows.map((row) => (
        <div class="blog-summary__row">
          <div class="blog-summary__label">{row.label}</div>
          <div class="blog-summary__cell">{row.summary}</div>
          <div class="blog-summary__cell blog-summary__cell--action">{row.action}</div>
        </div>
      ))}
    </div>
  )}

  {bullets.length > 0 && (
    <ul class="blog-summary__bullets">
      {bullets.map((bullet) => <li>{bullet}</li>)}
    </ul>
  )}
</aside>

<style>
  .blog-summary {
    background: linear-gradient(135deg, rgba(247, 249, 252, 0.95), var(--brand-white));
    border: 1px solid var(--brand-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    margin: var(--space-3) 0 var(--space-7);
    overflow: hidden;
  }
  .blog-summary__head {
    align-items: center;
    background: var(--brand-primary);
    color: var(--brand-white);
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr auto;
    padding: var(--space-5);
  }
  .blog-summary__head p {
    color: var(--brand-accent);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    grid-column: 1 / 2;
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: uppercase;
  }
  .blog-summary__head h2 {
    color: var(--brand-white);
    font-size: 1.55rem;
    grid-column: 1 / 2;
    margin: 0;
  }
  .blog-summary__head span {
    align-self: center;
    font-size: 2rem;
    grid-column: 2 / 3;
    grid-row: 1 / 3;
  }
  .blog-summary__intro {
    color: var(--brand-slate);
    padding: var(--space-5) var(--space-5) 0;
  }
  .blog-summary__facts {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(3, 1fr);
    padding: var(--space-5);
  }
  .blog-summary__fact {
    align-items: center;
    background: var(--brand-white);
    border: 1px solid var(--brand-border);
    border-radius: var(--radius-md);
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3);
  }
  .blog-summary__fact span {
    color: var(--brand-slate);
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
  }
  .blog-summary__fact strong {
    color: var(--brand-primary);
    display: block;
    font-family: var(--font-heading);
    font-size: 0.95rem;
  }
  .blog-summary__table {
    border-top: 1px solid var(--brand-border);
    margin: 0 var(--space-5) var(--space-5);
  }
  .blog-summary__row {
    border-bottom: 1px solid var(--brand-border);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 0.75fr 1fr 1fr;
    padding: var(--space-4) 0;
  }
  .blog-summary__label {
    color: var(--brand-primary);
    font-family: var(--font-heading);
    font-weight: 700;
  }
  .blog-summary__cell {
    color: var(--brand-slate);
    font-size: 0.95rem;
  }
  .blog-summary__cell--action {
    color: var(--brand-dark-text);
    font-weight: 600;
  }
  .blog-summary__bullets {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0 var(--space-5) var(--space-5);
  }
  .blog-summary__bullets li {
    color: var(--brand-slate);
    margin: 0;
    padding-left: var(--space-5);
    position: relative;
  }
  .blog-summary__bullets li::before {
    color: var(--brand-accent);
    content: "✓";
    font-weight: 700;
    left: 0;
    position: absolute;
  }
  @media (max-width: 760px) {
    .blog-summary__facts,
    .blog-summary__row {
      grid-template-columns: 1fr;
    }
  }
</style>
