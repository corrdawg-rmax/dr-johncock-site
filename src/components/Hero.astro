---
import CTAButton from "./CTAButton.astro";
import { config, telLink } from "../lib/config";

export interface Props {
  eyebrow?: string;
  headline: string;
  subhead?: string;
  imageSrc?: string;
  imageAlt?: string;
  primaryCtaHref?: string;
  primaryCtaLabel?: string;
  secondaryCtaHref?: string;
  secondaryCtaLabel?: string;
}

const {
  eyebrow,
  headline,
  subhead,
  imageSrc,
  imageAlt = "",
  primaryCtaHref = telLink(),
  primaryCtaLabel = config.contact.phone,
  secondaryCtaHref = "#book",
  secondaryCtaLabel = "Book online",
} = Astro.props;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
      <h1>{headline}</h1>
      {subhead && <p class="hero__sub">{subhead}</p>}
      <div class="hero__ctas">
        <CTAButton href={primaryCtaHref} variant="accent" size="large">
          {primaryCtaHref.startsWith("tel:") && <span class="cta__icon"><img src="/icons/telephone.svg" alt="" width="18" height="18" /></span>}
          {primaryCtaLabel}
        </CTAButton>
        <CTAButton href={secondaryCtaHref} variant="outline" size="large">{secondaryCtaLabel}</CTAButton>
      </div>
    </div>
    {imageSrc && (
      <div class="hero__media">
        <img src={imageSrc} alt={imageAlt} width="600" height="400" loading="eager" />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, var(--brand-light-bg) 0%, var(--brand-white) 100%);
    padding: var(--space-10) 0 var(--space-9);
    border-bottom: 1px solid var(--brand-border);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }
  @media (max-width: 850px) {
    .hero__inner { grid-template-columns: 1fr; }
  }
  .hero__eyebrow {
    text-transform: uppercase;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--brand-secondary);
    margin-bottom: var(--space-3);
  }
  .hero__copy h1 {
    font-size: 3.25rem;
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }
  @media (max-width: 850px) {
    .hero__copy h1 { font-size: 2.4rem; }
  }
  .hero__sub {
    font-size: 1.2rem;
    color: var(--brand-slate);
    margin-bottom: var(--space-6);
    max-width: 50ch;
  }
  .hero__ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .hero__media img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
</style>
