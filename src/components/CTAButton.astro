---
export interface Props {
  href: string;
  variant?: "primary" | "accent" | "outline";
  size?: "default" | "large";
  ariaLabel?: string;
}
const { href, variant = "primary", size = "default", ariaLabel } = Astro.props;
const classes = ["cta", `cta--${variant}`];
if (size === "large") classes.push("cta--large");
---
<a href={href} class={classes.join(" ")} aria-label={ariaLabel}>
  <slot />
</a>
