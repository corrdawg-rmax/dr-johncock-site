---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  title?: string;
  items: FAQItem[];
}

const { title = "Frequently Asked Questions", items } = Astro.props;
---

<section class="faq section--alt section">
  <div class="container--narrow">
    <h2>{title}</h2>
    <div class="faq__list">
      {items.map((item, i) => (
        <details class="faq__item" name={`faq-${title.replace(/\s+/g, "-").toLowerCase()}`}>
          <summary>
            <span>{item.question}</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="faq__answer"><p>{item.answer}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq h2 { text-align: center; margin-bottom: var(--space-7); }
  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .faq__item {
    background: var(--brand-white);
    border: 1px solid var(--brand-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .faq__item summary {
    cursor: pointer;
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--brand-dark-text);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary svg {
    flex-shrink: 0;
    color: var(--brand-primary);
    transition: transform 0.2s ease;
  }
  .faq__item[open] summary svg { transform: rotate(180deg); }
  .faq__item summary:hover { background: var(--brand-light-bg); }
  .faq__answer {
    padding: 0 var(--space-5) var(--space-5);
    color: var(--brand-slate);
  }
</style>
